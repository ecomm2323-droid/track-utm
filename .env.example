# Copy to .env.local for local use. In Railway, set these as service variables instead.

# Public URL of the app (no trailing slash). Used in tracker snippets, webhook URLs and the Meta login redirect.
APP_URL=https://your-app.up.railway.app

# Panel password. If empty, the panel is open (fine only on your own PC).
APP_PASSWORD=

# Meta app (developers.facebook.com > your app > Settings > Basic)
META_APP_ID=
META_APP_SECRET=

# First dashboard is created from this ad account (act_123...). More can be added in the Dashboards page.
META_AD_ACCOUNT_ID=

# Optional: fallback token if you have not used "Conectar con Meta" yet.
META_ACCESS_TOKEN=

# Production only: folder of the persistent volume that holds utmify.db (e.g. /data).
DATA_DIR=
